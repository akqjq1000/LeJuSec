# LeJuSec 에이전트 설정 예시.
#
# 원샷 설치(`curl .../install.sh | sudo bash`)가 자동 등록 후 이 형식의 파일
# (<config-dir>/agent.env)을 생성한다. 수동으로 쓰려면 이 파일을 복사해 값을 채운 뒤
# agent-run.sh 가 읽게 한다.
#
#   cp agent.env.example /etc/lejusec/agent.env   # 값 편집 후

# 컨트롤 플레인 베이스 URL (평문은 http://, mTLS는 https://)
LEJUSEC_SERVER=http://control-plane-host:8000

# 자산 ID (POST /assets 응답의 id). 설치 스크립트가 자동으로 채운다.
LEJUSEC_ASSET_ID=

# Ed25519 개인키 경로 (agent --keygen 으로 생성, 모드 600)
LEJUSEC_KEY=/etc/lejusec/agent.key

# 에이전트 바이너리 경로 (비우면 PATH 의 lejusec-agent 사용)
LEJUSEC_AGENT_BIN=/usr/local/bin/lejusec-agent

# mTLS (선택): 세 값을 함께 지정하면 전송 구간을 상호 TLS로 보호한다.
LEJUSEC_CA_CERT=
LEJUSEC_CLIENT_CERT=
LEJUSEC_CLIENT_KEY=
